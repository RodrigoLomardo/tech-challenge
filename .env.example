# Copie para .env e ajuste conforme necessário.

# Nível de log da aplicação: DEBUG | INFO | WARNING | ERROR
MEDAI_LOG_LEVEL=INFO

# Formato do log: text (legível) | json (estruturado, para produção)
MEDAI_LOG_FORMAT=text

# Caminho do artefato de modelo consumido pela API
MEDAI_MODEL_PATH=models/medai_breast_cancer_v1.joblib

# URL da API usada pela UI Streamlit
MEDAI_API_URL=http://localhost:8000

# Semente global de reprodutibilidade
MEDAI_RANDOM_STATE=42
